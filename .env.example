# Stripe — get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx

# Optional: Stripe Price IDs (recurring, monthly, EUR). If unset, the
# checkout uses the landing-page amounts inline (€9.99 / €29 / €149).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_COMMUNITY=
STRIPE_PRICE_VIP=

# Fallback site URL for redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leo — private analyst on the leo. subdomain
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Comma-separated; must match public.leo_operators in the database
LEO_ALLOWED_EMAILS=you@example.com
ANTHROPIC_API_KEY=sk-ant-xxx

# Leo trading bot (Freqtrade REST API on the bot server, see leo-bot/README.md)
LEO_BOT_URL=https://bot.your-domain
LEO_BOT_USERNAME=leo
LEO_BOT_PASSWORD=xxx
